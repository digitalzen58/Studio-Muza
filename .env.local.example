# Studio Mūza - Supabase Environment Variables
# Copy this file to .env.local and fill in your Supabase credentials from your Supabase Dashboard settings > API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Public application base URL (used for email confirmation callbacks and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dedicated server-only secret for signing password recovery intent tokens
MUZA_AUTH_RECOVERY_SECRET=your-strong-random-recovery-secret-here

# Pexels API Key for free stock media search (Server-side only)
# Obtain your free API key at https://www.pexels.com/api/
PEXELS_API_KEY=your-pexels-api-key-here
